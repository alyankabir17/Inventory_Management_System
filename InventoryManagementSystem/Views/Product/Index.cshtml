@using InventoryManagementSystem.Models.Entities
@using IMSClassLib

@model List<Product>

@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "Product Catalog";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-2">
                                <i class="fa fa-box me-2"></i>Product Catalog
                            </h2>
                            <p class="mb-0 opacity-75">
                                <i class="fa fa-warehouse me-2"></i>
                                Manage your inventory items
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light me-2">
                                <i class="fa fa-arrow-left me-2"></i>Dashboard
                            </a>
                            <a asp-action="Create" class="btn btn-warning text-dark fw-bold shadow">
                                <i class="fa fa-plus me-2"></i>Add Product
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-bold">ID</th>
                            <th class="fw-bold">Product Name</th>
                            <th class="fw-bold">Category</th>
                            <th class="fw-bold">Description</th>
                            <th class="fw-bold text-center">Quantity</th>
                            <th class="fw-bold text-center">Stock Status</th>
                            <th class="fw-bold text-end">Unit Price</th>
                            <th class="fw-bold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="align-middle">@product.Id</td>
                                    <td class="align-middle fw-semibold text-primary">@product.Name</td>
                                    <td class="align-middle">
                                        @if (product.Category != null)
                                        {
                                            <span class="badge bg-secondary">@product.Category.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td class="align-middle text-muted">@product.Description</td>
                                    <td class="align-middle text-center">
                                        <span class="badge bg-info fs-6">@product.Quantity</span>
                                    </td>

                                    @{
                                        var inventory = new InventoryManager();
                                        var status = inventory.CheckStockStatus(product.Quantity);
                                    }

                                    <td class="align-middle text-center">
                                        @if (status == 1)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa fa-check-circle me-1"></i>High Stock
                                            </span>
                                        }
                                        else if (status == 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fa fa-exclamation-triangle me-1"></i>Medium
                                            </span>
                                        }
                                        else if (status == -1)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa fa-times-circle me-1"></i>Low Stock
                                            </span>
                                        }
                                    </td>

                                    <td class="align-middle text-end fw-bold text-success">
                                        $@product.UnitPrice.ToString("N2")
                                    </td>

                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" class="btn btn-sm btn-primary" asp-route-id="@product.Id">
                                                <i class="fa fa-edit me-1"></i>Edit
                                            </a>
                                            <form method="post" asp-action="Delete" asp-route-id="@product.Id" 
                                                  onsubmit="return confirm('Are you sure you want to delete this product?');" 
                                                  class="d-inline">
                                                <button class="btn btn-sm btn-danger">
                                                    <i class="fa fa-trash me-1"></i>Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa fa-box-open fa-4x mb-3 d-block opacity-25"></i>
                                    <h5>No products found</h5>
                                    <p>Start by adding your first product to the catalog</p>
                                    <a asp-action="Create" class="btn btn-primary mt-2">
                                        <i class="fa fa-plus me-2"></i>Add Product
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>