@model InventoryManagementSystem.Models.AddModels.AddStaffMember

@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "Add Staff Member";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white p-4">
                    <h3 class="mb-0">
                        <i class="fa fa-user-plus me-2"></i>Add New Staff Member
                    </h3>
                    <p class="mb-0 small opacity-75">Enter employee information below</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Personal Information -->
                        <h5 class="fw-bold mb-3 text-primary">
                            <i class="fa fa-user me-2"></i>Personal Information
                        </h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CellNumber" class="form-label fw-bold">Cell Number</label>
                                <input asp-for="CellNumber" class="form-control" placeholder="+1234567890" />
                                <span asp-validation-for="CellNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter full address"></textarea>
                        </div>

                        <hr class="my-4" />

                        <!-- Employment Information -->
                        <h5 class="fw-bold mb-3 text-primary">
                            <i class="fa fa-briefcase me-2"></i>Employment Information
                        </h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Position" class="form-label fw-bold">Position</label>
                                <input asp-for="Position" class="form-control" placeholder="e.g., Sales Associate" />
                                <span asp-validation-for="Position" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label fw-bold">Department</label>
                                <input asp-for="Department" class="form-control" placeholder="e.g., Sales" />
                                <span asp-validation-for="Department" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Salary" class="form-label fw-bold">Monthly Salary</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Salary" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Salary" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfJoining" class="form-label fw-bold">Date of Joining</label>
                                <input asp-for="DateOfJoining" class="form-control" type="date" />
                                <span asp-validation-for="DateOfJoining" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold">Notes (Optional)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional information about the employee"></textarea>
                        </div>

                        <hr class="my-4" />

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fa fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa fa-save me-2"></i>Add Staff Member
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
