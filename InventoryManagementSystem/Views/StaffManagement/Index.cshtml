@model IEnumerable<InventoryManagementSystem.Models.Entities.StaffMember>

@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "Staff Management";
}

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-white">
                            <h2 class="fw-bold mb-2">
                                <i class="fa fa-users-cog me-2"></i>Staff Management
                            </h2>
                            <p class="mb-0 opacity-75">Manage employee records, salaries, and employment details</p>
                        </div>
                        <div>
                            <a asp-action="Create" class="btn btn-warning btn-lg text-dark fw-bold shadow">
                                <i class="fa fa-user-plus me-2"></i>Add Staff Member
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">ACTIVE STAFF</p>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalStaff</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="fa fa-users fa-2x text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">TOTAL MONTHLY SALARY</p>
                            <h3 class="fw-bold mb-0">$@ViewBag.TotalSalary.ToString("N2")</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="fa fa-dollar-sign fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">INACTIVE STAFF</p>
                            <h3 class="fw-bold mb-0">@ViewBag.InactiveStaff</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="fa fa-user-slash fa-2x text-warning"></i>
                        </div>
                    </div>
                    <a asp-action="Inactive" class="btn btn-sm btn-outline-warning mt-2">View Inactive</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Staff Members Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-bold">Employee</th>
                            <th class="fw-bold">Contact</th>
                            <th class="fw-bold">Position</th>
                            <th class="fw-bold">Department</th>
                            <th class="fw-bold">Salary</th>
                            <th class="fw-bold">Join Date</th>
                            <th class="fw-bold">Years</th>
                            <th class="fw-bold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var staff in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <span class="fw-bold text-primary">@staff.FirstName.Substring(0, 1)@staff.LastName.Substring(0, 1)</span>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@staff.FullName</div>
                                                <small class="text-muted">@staff.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div><i class="fa fa-phone text-primary me-1"></i>@staff.CellNumber</div>
                                        @if (!string.IsNullOrEmpty(staff.Address))
                                        {
                                            <small class="text-muted"><i class="fa fa-location-dot me-1"></i>@staff.Address</small>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-info">@staff.Position</span>
                                    </td>
                                    <td class="align-middle">@staff.Department</td>
                                    <td class="align-middle">
                                        <span class="fw-bold text-success">$@staff.Salary.ToString("N2")</span>
                                    </td>
                                    <td class="align-middle">
                                        <small>@staff.DateOfJoining.ToShortDateString()</small>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-secondary">@staff.YearsOfService years</span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <form asp-action="Deactivate" asp-route-id="@staff.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this staff member?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                                                    <i class="fa fa-user-slash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa fa-users fa-3x mb-3 d-block opacity-25"></i>
                                    <p class="mb-0">No staff members found. Click "Add Staff Member" to get started.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <small class="text-muted">
            <i class="fa fa-info-circle me-1"></i>
            <strong>Note:</strong> These are employee records for management purposes. Staff members cannot login to the system.
        </small>
    </div>
</div>
