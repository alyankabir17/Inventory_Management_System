@model IEnumerable<InventoryManagementSystem.Models.Entities.StaffMember>

@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "Inactive Staff Members";
}

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-white">
                            <h2 class="fw-bold mb-2">
                                <i class="fa fa-user-slash me-2"></i>Inactive Staff Members
                            </h2>
                            <p class="mb-0 opacity-75">View and manage inactive employee records</p>
                        </div>
                        <div>
                            <a asp-action="Index" class="btn btn-light btn-lg fw-bold shadow">
                                <i class="fa fa-arrow-left me-2"></i>Back to Active Staff
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Inactive Staff Members Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-bold">Employee</th>
                            <th class="fw-bold">Contact</th>
                            <th class="fw-bold">Position</th>
                            <th class="fw-bold">Department</th>
                            <th class="fw-bold">Salary</th>
                            <th class="fw-bold">Join Date</th>
                            <th class="fw-bold">Leave Date</th>
                            <th class="fw-bold">Duration</th>
                            <th class="fw-bold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var staff in Model)
                            {
                                <tr class="opacity-75">
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <span class="fw-bold text-danger">@staff.FirstName.Substring(0, 1)@staff.LastName.Substring(0, 1)</span>
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-muted">@staff.FullName</div>
                                                <small class="text-muted">@staff.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div><i class="fa fa-phone text-muted me-1"></i>@staff.CellNumber</div>
                                        @if (!string.IsNullOrEmpty(staff.Address))
                                        {
                                            <small class="text-muted"><i class="fa fa-location-dot me-1"></i>@staff.Address</small>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-secondary">@staff.Position</span>
                                    </td>
                                    <td class="align-middle">@staff.Department</td>
                                    <td class="align-middle">
                                        <span class="text-muted">$@staff.Salary.ToString("N2")</span>
                                    </td>
                                    <td class="align-middle">
                                        <small>@staff.DateOfJoining.ToShortDateString()</small>
                                    </td>
                                    <td class="align-middle">
                                        @if (staff.DateOfLeaving.HasValue)
                                        {
                                            <small class="text-danger">@staff.DateOfLeaving.Value.ToShortDateString()</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">N/A</small>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-warning text-dark">@staff.YearsOfService years</span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <form asp-action="Reactivate" asp-route-id="@staff.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to reactivate this staff member?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate">
                                                    <i class="fa fa-user-check"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Delete" asp-route-id="@staff.Id" method="post" class="d-inline" onsubmit="return confirm('?? WARNING: This will permanently delete this staff member from the database. This action cannot be undone!\n\nAre you absolutely sure you want to delete @staff.FullName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Permanently Delete">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fa fa-user-slash fa-3x mb-3 d-block opacity-25"></i>
                                    <p class="mb-0">No inactive staff members found.</p>
                                    <a asp-action="Index" class="btn btn-outline-primary mt-3">
                                        <i class="fa fa-arrow-left me-2"></i>View Active Staff
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <small class="text-muted">
            <i class="fa fa-info-circle me-1"></i>
            <strong>Note:</strong> Inactive staff members have left the organization but their records are retained for reference.
        </small>
    </div>
</div>
