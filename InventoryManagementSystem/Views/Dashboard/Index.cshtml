@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<div class="container-fluid">
    <!-- Welcome Header -->
    <div class="row mb-4 fade-in">
        <div class="col-12">
            <div class="card border-0 shadow-sm"
                style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-2">
                                <i class="fa fa-chart-line me-2"></i>
                                Welcome, @ViewBag.Username!
                            </h2>
                            <p class="mb-0 opacity-75">
                                <i class="fa fa-calendar me-2"></i>
                                @DateTime.Now.ToString("dddd, MMMM dd, yyyy") - Here's your inventory overview
                            </p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-dark fs-6 px-4 py-2">
                                <i class="fa fa-clock me-2"></i>@DateTime.Now.ToString("hh:mm tt")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-5 g-4">
        <div class="col-md-3">
            <div class="stat-card bg-gradient-primary shadow-lg">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase small mb-2 opacity-75">Total Products</h6>
                        <h2 class="display-4 fw-bold mb-0">@ViewBag.ProductsCount</h2>
                        <p class="small mb-0 mt-2">Items in inventory</p>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fa fa-box-open"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card bg-gradient-danger shadow-lg">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase small mb-2 opacity-75">Low Stock Alert</h6>
                        <h2 class="display-4 fw-bold mb-0">@ViewBag.LowStock</h2>
                        <p class="small mb-0 mt-2">Need reordering (< 5)</p>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card bg-gradient-success shadow-lg">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase small mb-2 opacity-75">Inventory Value</h6>
                        <h2 class="display-4 fw-bold mb-0">$@ViewBag.TotalInventoryValue.ToString("N0")</h2>
                        <p class="small mb-0 mt-2">Total asset value</p>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fa fa-dollar-sign"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card bg-gradient-info shadow-lg">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase small mb-2 opacity-75">Staff Members</h6>
                        <h2 class="display-4 fw-bold mb-0">@ViewBag.UsersCount</h2>
                        <p class="small mb-0 mt-2">Active accounts</p>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="fa fa-users"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold mb-3">
                <i class="fa fa-bolt text-warning me-2"></i>Quick Actions
            </h4>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-5">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <i class="fa fa-box fa-2x text-primary"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">Inventory Management</h4>
                    <p class="card-text text-muted mb-4">View, add, and update product stock levels</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                            <i class="fa fa-list me-2"></i>View Products
                        </a>
                        <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
                            <i class="fa fa-plus me-2"></i>Add New Product
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-5">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <i class="fa fa-cash-register fa-2x text-warning"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">Point of Sale</h4>
                    <p class="card-text text-muted mb-4">Process customer purchases and transactions</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Store" asp-action="Index" class="btn btn-warning text-white fw-bold">
                            <i class="fa fa-shop me-2"></i>Open POS Terminal
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-5">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <i class="fa fa-chart-bar fa-2x text-success"></i>
                    </div>
                    <h4 class="card-title fw-bold mb-3">Reports & Analytics</h4>
                    <p class="card-text text-muted mb-4">View sales reports and inventory analytics</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Sale" asp-action="Index" class="btn btn-outline-success">
                            <i class="fa fa-file-invoice me-2"></i>Sales Reports
                        </a>
                        <a asp-controller="Purchase" asp-action="Index" class="btn btn-success">
                            <i class="fa fa-cart-shopping me-2"></i>Purchase History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>