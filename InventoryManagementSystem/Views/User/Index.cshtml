@model List<InventoryManagementSystem.Models.Entities.Staff>;
@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "Staff Members";
}

<div class="container col-12 mt-5">
    <div class="d-flex bg-gradient text-light align-items-center justify-content-between p-4 rounded shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa fa-users me-2"></i>Staff Members</h2>
            <p class="mb-0 small opacity-75">Manage system staff accounts</p>
        </div>
        <a asp-action="Create" asp-controller="User" class="btn btn-light btn-lg shadow-sm">
            <i class="fa fa-user-plus me-2"></i>Add New Staff
        </a>
    </div>
    
    <div class="card border-0 shadow-sm mt-4">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="fw-bold">ID</th>
                    <th class="fw-bold">First Name</th>
                    <th class="fw-bold">Last Name</th>
                    <th class="fw-bold">Email</th>
                    <th class="fw-bold">Username</th>
                    <th class="fw-bold">Role</th>
                    <th class="text-center fw-bold">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td class="align-middle">@staff.Id</td>
                        <td class="align-middle">@staff.FirstName</td>
                        <td class="align-middle">@staff.LastName</td>
                        <td class="align-middle">
                            <i class="fa fa-envelope text-muted me-2"></i>@staff.Email
                        </td>
                        <td class="align-middle">
                            <span class="badge bg-primary">@staff.Username</span>
                        </td>
                        <td class="align-middle">
                            @if (staff.Role == "Admin")
                            {
                                <span class="badge bg-danger">
                                    <i class="fa fa-crown me-1"></i>Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Staff</span>
                            }
                        </td>
                        <td class="text-center align-middle">
                            <div class="d-flex align-items-center justify-content-center gap-2">
                                @if (staff.Role != "Admin")
                                {
                                    <a asp-action="Edit" class="btn btn-sm btn-warning" asp-route-id="@staff.Id">
                                        <i class="fa fa-edit me-1"></i>Edit
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@staff.Id" 
                                          onsubmit="return confirm('Are you sure you want to delete this staff member?')" 
                                          class="d-inline">
                                        <button class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled title="Admin account is protected">
                                        <i class="fa fa-shield me-1"></i>Protected
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>