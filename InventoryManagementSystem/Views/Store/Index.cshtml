@model IEnumerable<InventoryManagementSystem.Models.Entities.Product>

@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "POS Terminal";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body p-4 text-white">
                    <h2 class="fw-bold mb-2">
                        <i class="fa fa-cash-register me-2"></i>Point of Sale Terminal
                    </h2>
                    <p class="mb-0 opacity-75">
                        <i class="fa fa-shopping-cart me-2"></i>
                        Select products to process customer purchases
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 product-card">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-3">
                                <h5 class="card-title fw-bold text-primary mb-2">@item.Name</h5>
                                <p class="card-text text-muted small mb-3">@item.Description</p>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <small class="text-muted d-block">Price</small>
                                        <span class="fs-4 fw-bold text-success">$@item.UnitPrice.ToString("N2")</span>
                                    </div>

                                    @if (item.Quantity > 0)
                                    {
                                        if (item.Quantity <= 5)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fa fa-exclamation-triangle me-1"></i>
                                                Low: @item.Quantity
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa fa-check-circle me-1"></i>
                                                Stock: @item.Quantity
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fa fa-times-circle me-1"></i>
                                            Out of Stock
                                        </span>
                                    }
                                </div>

                                @if (item.Quantity > 0)
                                {
                                    <a asp-controller="Store" asp-action="Buy" asp-route-id="@item.Id" 
                                       class="btn btn-primary w-100">
                                        <i class="fa fa-shopping-cart me-2"></i>Sell Product
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        <i class="fa fa-ban me-2"></i>Unavailable
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fa fa-box-open fa-4x text-muted mb-3 opacity-25"></i>
                        <h4 class="text-muted">No Products Available</h4>
                        <p class="text-muted">Add products to your inventory to start selling</p>
                        <a asp-controller="Product" asp-action="Create" class="btn btn-primary mt-3">
                            <i class="fa fa-plus me-2"></i>Add Product
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .product-card {
        transition: all 0.3s ease;
    }

    .product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15) !important;
    }
</style>