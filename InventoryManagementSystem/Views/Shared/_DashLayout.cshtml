@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InventoryManagementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryManagementSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <style>
        .sidebar {
            background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1e 100%);
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }

        .sidebar-link {
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            border-left-color: #667eea;
            padding-left: 1rem !important;
        }

        .sidebar-link.active {
            background: linear-gradient(90deg, rgba(102, 126, 234, 0.2) 0%, transparent 100%);
            border-left-color: #667eea;
        }

        .top-bar {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            backdrop-filter: blur(10px);
        }

        .logo-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="overflow-hidden">
    <div class="d-flex align-items-start justify-content-start col-12 w-100 m-0 p-0 overflow-hidden" style="width: 100vw;">

        <aside class="sidebar col-2 text-decoration-none vh-100 d-flex flex-column p-3 justify-content-start">
            <div class="text-center mb-4 pb-3 border-bottom border-secondary">
                <h1 class="fw-bold text-light display-5 logo-text">IMS</h1>
                <p class="text-light small opacity-75 mb-0">Inventory System</p>
            </div>
            
            <nav class="flex-grow-1">
                <ul class="list-group bg-none gap-2">

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Store" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-shop me-3"></i>POS Terminal
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Product" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-box me-3"></i>Product Catalog
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="LowStock" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-danger d-block p-3 rounded">
                            <i class="fa fa-exclamation-triangle me-3"></i>Low Stock Alert
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Category" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-tags me-3"></i>Categories
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Supplier" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-truck me-3"></i>Suppliers
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Customer" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-star me-3"></i>Favorite Customers
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Purchase" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-cart-shopping me-3"></i>Restock Inventory
                        </a>
                    </li>

                    <li class="list-group-item bg-transparent border-0 p-0">
                        <a asp-controller="Sale" asp-action="Index" 
                           class="sidebar-link text-decoration-none text-light d-block p-3 rounded">
                            <i class="fa fa-chart-line me-3"></i>Sales Ledger
                        </a>
                    </li>

                    <hr class="text-light my-3" />

                    @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin")
                    {
                        <li class="list-group-item bg-transparent border-0 p-0">
                            <a asp-controller="StaffManagement" asp-action="Index" 
                               class="sidebar-link text-decoration-none text-info d-block p-3 rounded">
                                <i class="fa fa-users-cog me-3"></i>Staff Management
                            </a>
                        </li>
                    }

                </ul>
            </nav>

            <div class="mt-auto pt-3 border-top border-secondary">
                <a asp-controller="User" asp-action="Logout" 
                   class="sidebar-link text-decoration-none text-danger d-block p-3 rounded">
                    <i class="fa fa-right-from-bracket me-3"></i>Logout
                </a>
            </div>
        </aside>

        <div class="col-10 vh-100 overflow-scroll">
            <div class="top-bar border-bottom p-4 d-flex align-items-center justify-content-between sticky-top shadow-sm">
                <div>
                    <h2 class="fw-bold fs-3 m-0 text-dark">
                        <i class="fa fa-dashboard me-2 text-primary"></i>Admin Dashboard
                    </h2>
                    <p class="text-muted small mb-0">
                        <i class="fa fa-user-circle me-1"></i>
                        Welcome, <strong>@(HttpContextAccessor.HttpContext.Session.GetString("Username") ?? "Admin")</strong>
                    </p>
                </div>
                <a asp-controller="User" asp-action="Logout" 
                   title="Logout" 
                   class="btn btn-danger shadow-sm">
                    <i class="fa fa-right-from-bracket me-2"></i>Sign Out
                </a>
            </div>
            <main role="main" class="p-4 bg-light" style="min-height: calc(100vh - 100px);">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>