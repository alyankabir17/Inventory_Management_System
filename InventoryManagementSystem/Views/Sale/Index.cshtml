@model IEnumerable<InventoryManagementSystem.Models.Entities.Sale>

@{
    Layout = "~/Views/Shared/_DashLayout.cshtml";
    ViewData["Title"] = "Sales";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 bg-dark text-white p-3 rounded">
        <h2 class="mb-0 fw-bold"><i class="fa fa-chart-line me-2"></i>Sales History</h2>
        <a asp-controller="Store" asp-action="Index" class="btn btn-warning fw-bold">
            <i class="fa fa-shop me-2"></i>Go to Store
        </a>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Product ID</th>
                <th>Customer</th>
                <th>Type</th>
                <th>Contact</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SaleDate.ToShortDateString() @item.SaleDate.ToShortTimeString()</td>
                    <td>@item.ProductId</td>
                    <td>
                        @if (item.IsFavoriteCustomer)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="fa fa-star me-1"></i>@item.CustomerName
                            </span>
                        }
                        else
                        {
                            @item.CustomerName
                        }
                    </td>
                    <td>
                        @if (item.IsFavoriteCustomer)
                        {
                            <span class="badge bg-success">Favorite</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Walk-in</span>
                        }
                    </td>
                    <td>@(item.CustomerContact ?? "-")</td>
                    <td>@item.Quantity</td>
                    <td>$@item.SoldPrice.ToString("N2")</td>
                    <td class="fw-bold text-success">$@item.TotalAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>